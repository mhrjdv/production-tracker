# Database Connection
# Replace with your actual database credentials
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# NextAuth Configuration
# Generate a secret using `npx auth secret` or any secure random string
AUTH_SECRET="your-secret-key-here"

# The base URL of your application
NEXTAUTH_URL="http://localhost:3000"

# Set to true if deploying behind a proxy (e.g., Vercel, Docker)
AUTH_TRUST_HOST=true

# AI Configuration (OpenRouter)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
# Default model for AI generation (any OpenRouter-compatible model)
AI_MODEL="x-ai/grok-4.1-fast"
# Enable/disable AI request/response logging ("true" or "false")
AI_LOGGING="true"

# Cloudflare R2 Storage
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="production-tracker"
R2_PUBLIC_URL="https://your-public-bucket-url.r2.dev"
