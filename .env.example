# Database Connection
# Replace with your actual database credentials
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Supabase Auth
# Get these from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# AI Configuration (OpenRouter)
# Get your API key from https://openrouter.ai/keys
API_KEY="your-openrouter-api-key"
# Default model for AI generation (any OpenRouter-compatible model)
AI_MODEL="anthropic/claude-haiku-4.5"
# Enable/disable AI request/response logging ("true" or "false")
AI_LOGGING="true"

# Cloudflare R2 Storage
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="production-tracker"
R2_PUBLIC_URL="https://your-public-bucket-url.r2.dev"
