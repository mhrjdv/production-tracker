{
  "manifest_version": 3,
  "name": "Production Tracker Sync",
  "version": "0.1.0",
  "description": "Capture prompts and generated outputs from AI platforms and sync them to scene versions.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Production Tracker Sync",
    "default_popup": "popup.html"
  }
}
