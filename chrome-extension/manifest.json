{
  "manifest_version": 3,
  "name": "Production Tracker Sync",
  "version": "0.2.0",
  "description": "Capture prompts and generated outputs from AI platforms and sync them to scene versions.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Production Tracker Sync"
  }
}
