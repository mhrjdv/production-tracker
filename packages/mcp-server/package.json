{
  "name": "@lazer/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Lazer AI film production orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lazer-mcp": "./dist/transports/stdio.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start:stdio": "node dist/transports/stdio.js",
    "start:http": "node dist/transports/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "pg": "^8.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
