// ============================================================
// Prisma Schema — Production Tracker Platform
// Multi-tenant with Supabase Auth
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User (synced with Supabase auth.users) ─────────────────

model User {
  id            String    @id @default(cuid())
  supabaseId    String?   @unique @map("supabase_id")
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String    @default("") @map("password_hash")
  image         String?
  extensionPreferences Json? @map("extension_preferences")
  projects      Project[]
  sceneAssets   SceneAssetVersion[] @relation("SceneAssetCreatedBy")
  promptPackages PromptPackage[] @relation("PromptPackageCreatedBy")
  apiTokens     ExtensionApiToken[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Core Domain ─────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  genre       String?
  status      String        @default("active") // active, archived, completed
  coverImage  String?       @map("cover_image")
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  characters  Character[]
  identity    FilmIdentity?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("projects")
}

model Scene {
  id                String   @id @default(cuid())
  sceneId           String   @map("scene_id") // User-facing ID (S001, S002)
  projectId         String   @map("project_id")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceText        String   @map("source_text")
  reason            String   @default("")
  act               Int
  actTitle          String   @map("act_title")
  macroScene        String   @map("macro_scene")
  storyBeat         String   @map("story_beat")
  narrativePurpose  String?  @map("narrative_purpose")
  emotionalTone     String?  @map("emotional_tone")
  setting           Json?
  camera            Json?
  actions           String[]
  visualMotifs      String[] @map("visual_motifs")
  constraints       String[]
  charactersPresent String[] @map("characters_present")
  keyframeUrl       String?  @map("keyframe_url")
  sortOrder         Int      @default(0) @map("sort_order")
  shots             Shot[]
  characters        SceneCharacter[]
  promptPackages    PromptPackage[]
  assets            SceneAssetVersion[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([projectId, sceneId])
  @@index([projectId])
  @@map("scenes")
}

model Character {
  id               String   @id @default(cuid())
  name             String
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role             String
  designPhilosophy String?  @map("design_philosophy")
  visualCues       String[] @map("visual_cues")
  bodyLanguage     String[] @map("body_language")
  coreIdentity     String?  @map("core_identity")
  portraitUrl      String?  @map("portrait_url")
  scenes           SceneCharacter[]
  shots            ShotCharacter[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([projectId, name])
  @@index([projectId])
  @@map("characters")
}

model FilmIdentity {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("film_identities")
}

// ─── Shot (first-class capture unit inside Scene) ────────────

model Shot {
  id          String   @id @default(cuid())
  shotCode    String   @map("shot_code")      // SH001, SH002
  sceneId     String   @map("scene_id")
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  description String   @db.Text
  angle       String?                          // wide, medium, close-up, OTS, POV, aerial, insert
  framing     String?                          // framing notes
  movement    String?                          // pan, tilt, dolly, crane, handheld, steadicam, static
  lensNotes   String?  @map("lens_notes")
  references  Json?                            // attached reference images, style refs
  sortOrder   Int      @default(0) @map("sort_order")
  assets      SceneAssetVersion[]
  promptPackages PromptPackage[]
  characters  ShotCharacter[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([sceneId, shotCode])
  @@index([sceneId])
  @@map("shots")
}

enum AssetType {
  SCRIPT
  IMAGE
  VIDEO
  AUDIO
  MUSIC
  VOICE
  NARRATION
  STORYBOARD
  OTHER
}

enum AssetStatus {
  DRAFT
  GENERATED
  NEEDS_REVIEW
  REVIEWED
  APPROVED
  SELECTED
  REJECTED
  ARCHIVED
  FINAL
}

enum RightsState {
  UNKNOWN
  NON_COMMERCIAL
  COMMERCIAL_ALLOWED
  RESTRICTED
}

model PromptPackage {
  id               String    @id @default(cuid())
  sceneId          String    @map("scene_id")
  scene            Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotId           String?   @map("shot_id")
  shot             Shot?     @relation(fields: [shotId], references: [id], onDelete: SetNull)
  versionNumber    Int       @default(1) @map("version_number")
  name             String?
  prompt           String    @db.Text
  negativePrompt   String?   @map("negative_prompt") @db.Text
  constraints      Json?
  targetAspectRatio String?  @map("target_aspect_ratio")
  targetDurationSec Int?     @map("target_duration_sec")
  styleProfile     String?   @map("style_profile")
  tags             String[]
  metadata         Json?
  createdById      String?   @map("created_by_id")
  createdBy        User?     @relation("PromptPackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assets           SceneAssetVersion[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([sceneId])
  @@index([shotId])
  @@index([createdById])
  @@unique([sceneId, versionNumber])
  @@map("prompt_packages")
}

model AiPlatform {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  provider        String?
  homepageUrl     String?             @map("homepage_url")
  docsUrl         String?             @map("docs_url")
  specialties     String[]
  supportedOutput AssetType[]         @map("supported_output")
  notes           String?
  sceneAssets     SceneAssetVersion[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("ai_platforms")
}

model SceneAssetVersion {
  id              String      @id @default(cuid())
  sceneId         String      @map("scene_id")
  scene           Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotId          String?     @map("shot_id")
  shot            Shot?       @relation(fields: [shotId], references: [id], onDelete: SetNull)
  promptPackageId String?     @map("prompt_package_id")
  promptPackage   PromptPackage? @relation(fields: [promptPackageId], references: [id], onDelete: SetNull)
  platformId      String?     @map("platform_id")
  platform        AiPlatform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  parentVersionId String?     @map("parent_version_id")
  parentVersion   SceneAssetVersion? @relation("SceneAssetDerivatives", fields: [parentVersionId], references: [id], onDelete: SetNull)
  derivedVersions SceneAssetVersion[] @relation("SceneAssetDerivatives")
  platformKey     String      @map("platform_key")
  platformLabel   String      @map("platform_label")
  assetType       AssetType   @map("asset_type")
  status          AssetStatus @default(DRAFT)
  rightsState     RightsState @default(UNKNOWN) @map("rights_state")
  versionNumber   Int         @default(1) @map("version_number")
  title           String?
  prompt          String      @db.Text
  negativePrompt  String?     @map("negative_prompt") @db.Text
  modelName       String?     @map("model_name")
  sourceUrl       String?     @map("source_url")
  externalAssetId String?     @map("external_asset_id")
  outputUrl       String?     @map("output_url")
  thumbnailUrl    String?     @map("thumbnail_url")
  costEstimateUsd Float?      @map("cost_estimate_usd")
  generationSeconds Int?      @map("generation_seconds")
  queueWaitSeconds Int?       @map("queue_wait_seconds")
  compareGroup    String?     @map("compare_group")
  metadata        Json?
  provenance      Json?
  tags            String[]
  notes           String?     @db.Text
  selected        Boolean     @default(false)
  createdById     String?     @map("created_by_id")
  createdBy       User?       @relation("SceneAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([sceneId])
  @@index([shotId])
  @@index([promptPackageId])
  @@index([parentVersionId])
  @@index([platformKey])
  @@index([assetType])
  @@index([status])
  @@index([rightsState])
  @@index([compareGroup])
  @@index([createdById])
  @@index([selected, status])
  @@unique([sceneId, platformKey, assetType, versionNumber])
  @@map("scene_asset_versions")
}

model ExtensionApiToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([revokedAt])
  @@map("extension_api_tokens")
}

// ─── Character Junction Tables ──────────────────────────────

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String    @map("scene_id")
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([sceneId, characterId])
  @@index([sceneId])
  @@index([characterId])
  @@map("scene_characters")
}

model ShotCharacter {
  id          String    @id @default(cuid())
  shotId      String    @map("shot_id")
  shot        Shot      @relation(fields: [shotId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([shotId, characterId])
  @@index([shotId])
  @@index([characterId])
  @@map("shot_characters")
}
